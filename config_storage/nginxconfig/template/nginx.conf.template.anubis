map $http_x_forwarded_proto $fastcgi_param_https_variable {
    default '';
    https 'on';
}

map $http_x_requested_with $limit_non_ajax_ip {
        default           $binary_remote_addr;
        ~*XMLHttpRequest  "";
}

# 10MB zone or ~160K IPs, max 5 requests/sec per IP
limit_req_zone $binary_remote_addr zone=limit_non_ajax_ip:10m rate=5r/s;

upstream cantaloupe {
    server esmero-cantaloupe:8182;
    keepalive 32;
}

upstream drupal {
    server esmero-web:61111;
}

upstream anubis {

    # Make sure this matches the values you set for `BIND` and `BIND_NETWORK`.
    # If this does not match, your services will not be protected by Anubis.

    server esmero-anubis:8969;

    # Optional: fall back to serving the websites directly. This allows your
    # websites to be resilient against Anubis failing, at the risk of exposing
    # them to the raw internet without protection. This is a tradeoff and can
    # be worth it in some edge cases.
}


server {

    listen 443 ssl;
    server_name         ${FQDN};
    ssl_certificate     /etc/letsencrypt/live/${FQDN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${FQDN}/privkey.pem;
    ## TUS Protocol will still need client_max_body_size value to match max File Size, event if never really sending a complete POST that requires it.
    client_max_body_size 4096M; ## Larger or equal to PHP from FPM container. At least as large as TUS File Upload MAX.
 
    if ($http_user_agent ~* (go\-http|aio\-kb\-crawler|siteimprove|zgrab|mj12bot|meta\-webindexer|meta\-externalagent|oai\-searchbot|tiktok|tiktokspider|lplinkcheck|netcrawl|npbot|AliyunSecBot|bytedance|bytespider|gptbot|semrush|petalbot|amazonbot|ahrefsbot|zhanzhang|semrushbot|brightbot|imagesiftbot|barkrowler|friendlycrawler|turnitin|claudebot|python-requests|aiohttp|semanticscholarbot|go\-http\-client|facebookexternalhit)){
      return 444;
    }
    
    # Security
    location ^~ /jsonapi/user/user {
      deny all;
      return 403;
    }
 
    location = /core/install.php {
      deny all;
      return 403;
    }    

    fastcgi_send_timeout 120s;
    fastcgi_read_timeout 120s;
    fastcgi_pass_request_headers on;
    proxy_connect_timeout 120s;
    proxy_send_timeout 120s;
    proxy_read_timeout 300s;

    fastcgi_buffers 16 16k;
    fastcgi_buffer_size 32k;

    # Please adapt to your needs
    proxy_buffers 16 16k;
    proxy_buffer_size 16k;
    include /etc/nginx/conf.d/bots.include;

    #gzip
    gzip on;
    gzip_disable "msie6";

    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_buffers 16 8k;
    gzip_http_version 1.1;
    gzip_min_length 256;
    gzip_types
    application/atom+xml
    application/geo+json
    application/javascript
    application/x-javascript
    application/json
    application/ld+json
    application/manifest+json
    application/rdf+xml
    application/rss+xml
    application/xhtml+xml
    application/xml
    font/eot
    font/otf
    font/ttf
    image/svg+xml
    text/css
    text/javascript
    text/plain
    text/xml;


    location /cantaloupe/ {

        include /etc/nginx/conf.d/ipdeny.include;
        proxy_http_version 1.1;
        set_real_ip_from 172.17.0.0/16;
        real_ip_header X-Real-IP;
        real_ip_recursive on;
        proxy_set_header "Connection" "";
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-Path /cantaloupe/;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
        if ($request_uri ~* "/cantaloupe/(.*)") {
            proxy_pass http://cantaloupe/$1;
        }
    }

    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    location ~* ^/.within./\.website {
        allow all;
    }
    location ^~ /.within.website/ {
        allow all;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_pass http://anubis;
    }

    location = /favicon.ico {

        log_not_found off;
        access_log off;
    }

    location = /robots.txt {

        allow all;
        log_not_found off;
        access_log off;
    }

    # Very rarely should .txt and .log ever be accessed
    # But now we allow /do/ download endpoints to serve .txt and .log

    location ~* ^(?!/do/.+/(file|metadata)/(?!\.(txt|log)$)).*\.(txt|log)$ {
        deny all;
    }

    location ~ \..*/.*\.php$ {
        return 403;
    }

    location ~ ^/sites/.*/private/ {
        return 403;
    }

    # Allow "Well-Known URIs" as per RFC 5785
    location ~* ^/.well-known/ {
        allow all;
    }

    # Block access to "hidden" files and directories whose names begin with a
    # period. This includes directories used by version control systems such
    # as Subversion or Git to store control files.
    location ~ (^|/)\. {
        return 403;
    }

    # Don't allow direct access to PHP files in the vendor directory.
    location ~ /vendor/.*\.php$ {
        deny all;
        return 404;
    }


    # Tus upload to allow resumes
    location /webform_strawberry/tus_upload/ {
        include /etc/nginx/conf.d/ipdeny.include;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_http_version 1.1;
        proxy_pass http://drupal$request_uri;
    }


    location / {
        include /etc/nginx/conf.d/ipdeny.include;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_pass http://anubis;
    }
    # Enforce clean URLs
    # Removes index.php from urls like www.example.com/index.php/my-page --> www.example.com/my-page
    # Could be done with 301 for permanent or other redirect codes.
    # if this is inside the proxied drupal location it will go into for-ever loop. Keep it here
    if ($request_uri ~* "^(.*/)index\.php/(.*)") {
        return 307 $1$2;
    }
}

server {

    listen 61111;
    server_name ${FQDN};
    client_max_body_size 1536M; ## Match with PHP from FPM container
    set_real_ip_from 172.16.0.0/12; ## Docker Network. Change if running on other private nets.
    real_ip_header X-Real-IP;
    real_ip_recursive on;

    root /var/www/html/web; ## <-- Your only path reference.

    fastcgi_send_timeout 120s;
    fastcgi_read_timeout 120s;
    fastcgi_pass_request_headers on;
    proxy_connect_timeout 120s;
    proxy_send_timeout 120s;
    proxy_read_timeout 300s;

    fastcgi_buffers 16 16k;
    fastcgi_buffer_size 32k;

    # Please adapt to your needs
    proxy_buffers 16 16k;
    proxy_buffer_size 16k;

    # Allow "Well-Known URIs" as per RFC 5785
    location ~* ^/.well-known/ {
        allow all;
    }

    location / {
        try_files $uri /index.php?$query_string; # For Drupal >= 7
    }

    location @rewrite {
        rewrite ^/(.*)$ /index.php?q=$1;
    }

    # Allow Modules to be updated via UI (still we believe composer is the way)
    rewrite ^/core/authorize.php/core/authorize.php(.*)$ /core/authorize.php$1;

    # In Drupal 8+, we must also match new paths where the '.php' appears in
    # the middle, such as update.php/selection. The rule we use is strict,
    # and only allows this pattern with the update.php front controller.
    # This allows legacy path aliases in the form of
    # blog/index.php/legacy-path to continue to route to Drupal nodes. If
    # you do not have any paths like that, then you might prefer to use a
    # laxer rule, such as:
    #   location ~ \.php(/|$) {
    # The laxer rule will continue to work if Drupal uses this new URL
    # pattern with front controllers other than update.php in a future
    # release.
    location ~ '\.php$|^/update.php' {
        include /etc/nginx/conf.d/ipdeny.include;
        fastcgi_split_path_info ^(.+?\.php)(|/.*)$;
        include fastcgi_params;
        fastcgi_param SERVER_PORT $http_x_forwarded_port;
        # Block httpoxy attacks. See https://httpoxy.org/.
        fastcgi_param HTTP_PROXY "";
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_param HTTPS $fastcgi_param_https_variable if_not_empty;
        fastcgi_param PHP_VALUE "upload_max_filesize=1536M \n post_max_size=1536M \n max_execution_time=900";
        proxy_read_timeout 900s;
        fastcgi_intercept_errors on;
        fastcgi_keep_conn on;
        fastcgi_pass esmero-php:9000;
    }

    # Fighting with Styles? This little gem is amazing.
    location ~ ^/sites/.*/files/styles/ {
        # For Drupal >= 7
        try_files $uri @rewrite;
    }

    # Handle private files through Drupal.
    location ~ ^/system/files/ {
        # For Drupal >= 7
        try_files $uri /index.php?$query_string;
    }

}
